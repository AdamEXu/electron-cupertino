{
  "name": "electron-cupertino",
  "version": "0.0.2",
  "description": "Make your Electron app look genuinely macOS-native: vibrancy window setup, measured sidebar & settings chrome, SF Symbols rendering.",
  "license": "MIT",
  "author": "Adam Xu",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "require": "./dist/main.cjs"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "import": "./dist/preload.js",
      "require": "./dist/preload.cjs"
    },
    "./symbols": {
      "types": "./dist/symbols.d.ts",
      "import": "./dist/symbols.js",
      "require": "./dist/symbols.cjs"
    },
    "./css/*": "./css/*"
  },
  "files": [
    "dist",
    "css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "electron": ">=28",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "electron": "^31.0.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "electron",
    "macos",
    "cupertino",
    "native",
    "vibrancy",
    "sidebar",
    "settings",
    "sf-symbols",
    "titlebar",
    "traffic-lights"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamEXu/electron-cupertino.git"
  },
  "bugs": {
    "url": "https://github.com/AdamEXu/electron-cupertino/issues"
  },
  "homepage": "https://github.com/AdamEXu/electron-cupertino#readme"
}
